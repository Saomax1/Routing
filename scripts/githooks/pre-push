#!/bin/sh
# Last line of defence: scan every commit about to be pushed (even ones made with --no-verify).
HERE=$(cd "$(dirname "$0")" && pwd)
PY=$(command -v python3 || command -v python) || { echo "leak check: python was not found, so this push cannot be checked" >&2; exit 2; }
exec "$PY" "$HERE/../leak_check.py" --pushing
