#!/bin/sh
# Refuse a commit MESSAGE that contains real customer information or an API key.
HERE=$(cd "$(dirname "$0")" && pwd)
PY=$(command -v python3 || command -v python) || { echo "leak check: python was not found, so this message cannot be checked" >&2; exit 2; }
exec "$PY" "$HERE/../leak_check.py" --message "$1"
