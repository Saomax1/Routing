# Copy to .env and fill in. NEVER commit .env. Keys are read server-side only and never sent to the browser.

# --- Housecall Pro ---------------------------------------------------------------------------
# mock = sanitized demo data, no network (default, safe for trying the app)
# live = reads your real Housecall Pro account (READ-ONLY in this version)
HCP_MODE=mock
HCP_API_KEY=
# UNVERIFIED defaults - confirm with scripts/phase0_probe.py before trusting live data
HCP_BASE_URL=https://api.housecallpro.com
HCP_AUTH_SCHEME=Token
HCP_PAGE_SIZE=100

# --- Geocoding / maps ------------------------------------------------------------------------
# mock | census | google | mapbox   (live data needs census, google or mapbox so pins land on real addresses)
GEOCODER=mock
MAPS_API_KEY=

# --- Storage / sessions ----------------------------------------------------------------------
DATABASE_PATH=data/routing.db
# Long random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random one is generated at startup (everyone is logged out on every restart).
SESSION_SECRET=
# Set true when served over HTTPS (required in production)
SESSION_HTTPS_ONLY=false
# Reserved for Phase 2 webhooks (not used yet)
WEBHOOK_SECRET=

# --- Sync ------------------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=300
SYNC_ON_STARTUP=true
SCHEDULED_WINDOW_DAYS=14

# --- Server ----------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# --- First admin login (optional; if empty a one-time password is printed in mock mode) ------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional AI fallback for warranty text the regex parser can't read ----------------------
# OFF unless BOTH are set. Customer names and phone numbers are redacted before anything is sent.
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=https://api.anthropic.com/v1/messages
